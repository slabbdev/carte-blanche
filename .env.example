# --- Server ---
PORT=8790

# --- PayPal rails ---
# mock    = in-memory simulator, clearly labeled MOCK-* ids (default, no keys needed)
# sandbox = real PayPal sandbox REST API (needs developer dashboard credentials)
# live    = real PayPal production API (not used for the hackathon demo)
PAYPAL_MODE=mock
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- LLM agent (optional, any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# AG Studio (/analytics) — build-time, read by Vite. Empty = watermark + console warnings, every feature works.
# Free 45-day trial: https://www.ag-grid.com/studio/license-pricing/?tab=trial
VITE_AG_STUDIO_LICENSE_KEY=

# --- Local state ---
KEYS_DIR=./.keys
STATE_DIR=./state
