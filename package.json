{
  "name": "carte-blanche",
  "version": "0.3.0",
  "description": "Spending mandates, sealed receipts and dispute-proof audits for AI agents paying with PayPal",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-web.mjs",
    "dev": "tsx watch src/server.ts",
