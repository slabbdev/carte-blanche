{
  "name": "carte-blanche",
  "version": "0.3.0",
  "description": "Spending mandates, sealed receipts and dispute-proof audits for AI agents paying with PayPal",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && cd web && npm install --include=dev --no-audit --no-fund && npm run build && cd ..",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "demo": "tsx src/agent/demo.ts",
    "demo:intent": "tsx src/agent/demo-amex.ts",
    "demo:llm": "tsx src/agent/llm.ts",
    "roundtrip:sandbox": "tsx scripts/sandbox-roundtrip.ts",
    "wallet:purchase": "tsx scripts/wallet-purchase.ts",
    "anchor": "tsx scripts/anchor.ts",
    "smoke:tsa": "tsx scripts/anchor.ts",
    "wallet2:create": "tsx scripts/wallet2.ts",
    "wallet2:watch": "tsx scripts/wallet2.ts",
    "apimatic:sync": "tsx scripts/apimatic-sync.ts",
    "mcp": "tsx mcp/server.ts",
    "tx:label-proof": "tsx scripts/tx-label-proof.ts",
    "demo:full": "tsx src/agent/demo-full.ts",
    "demo:recurring": "tsx src/agent/demo-recurring.ts",
    "postman": "openapi-to-postmanv2 -s docs/openapi.json -o docs/postman/carte-blanche.postman_collection.json -p -O folderStrategy=Tags,requestParametersResolution=Example"
  },
  "dependencies": {
    "@bryntum/calendar-trial": "^7.3.7",
    "@bryntum/taskboard-trial": "^7.3.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@paypal/mcp": "^1.8.1",
    "@paypal/paypal-js": "^11.2.2",
    "ag-charts-community": "^14.2.0",
    "ag-grid-community": "^36.2.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "openapi-to-postmanv2": "^6.4.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
